<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Not sandboxed: we read agent session files under ~/, talk to the lid-angle HID device,
	     and install agent hooks. Hardened runtime is on for notarization. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
