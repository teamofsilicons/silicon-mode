<?xml version="1.0" encoding="utf-8"?>
<!-- A half-closed laptop seen from the side, with its lid angle: the Silicon Mode mark. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- angle arc -->
    <path
        android:pathData="M48,70 A16,16 0 0,0 40,56.14"
        android:strokeColor="#FF3460F0"
        android:strokeWidth="4.5"
        android:strokeLineCap="round" />
    <!-- base -->
    <path
        android:pathData="M32,70 L78,70"
        android:strokeColor="#FF1B1B1B"
        android:strokeWidth="6"
        android:strokeLineCap="round" />
    <!-- lid at 60 degrees -->
    <path
        android:pathData="M32,70 L53,33.63"
        android:strokeColor="#FF1B1B1B"
        android:strokeWidth="6"
        android:strokeLineCap="round" />
    <!-- an agent at work -->
    <path
        android:pathData="M68,48 m-4,0 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0"
        android:fillColor="#FF3460F0" />
</vector>
