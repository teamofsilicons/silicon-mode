#!/usr/bin/env bash
# smctl — drive a running (debug) Silicon Mode app from the shell.
#
#   scripts/smctl angle=60        # simulate the lid at 60°
#   scripts/smctl angle=off       # back to the real sensor
#   scripts/smctl enter | cancel | turnoff | unlock=123456 | unlockui | setpin=123456
#   scripts/smctl face=orbit | stats | menubar | onboarding | settings | refresh
#   scripts/smctl setting=countdownSeconds:3
#   scripts/smctl demo=question | demo=permission | demo=off
#                                 # a made-up agent waiting on a question (demo-q1) or a permission
#                                 # (demo-p1); UI only: never synced, never in usage, never counted
#                                 # for auto-entry or panic. Its question sorts first; answered, it
#                                 # carries on working until demo=off.
#   scripts/smctl 'answer=o0'     # while a demo agent is shown, its question (never a real one);
#                                 # otherwise the oldest answerable question. 'answer=o0|some text'
#                                 # adds a reply, 'answer=|text' sends a reply only
#   scripts/smctl 'answer=demo-p1:allow'   # answer=<questionID>:<optionID>[|text]: that question
#                                 # (unknown options are refused; see lastAnswer in the state)
#   scripts/smctl state           # print the current state (dump + read)
set -euo pipefail
STATE="$HOME/Library/Application Support/Silicon Mode/debug-state.json"
cmd="${1:-state}"
post() {
  swift -e "import Foundation; DistributedNotificationCenter.default().postNotificationName(.init(\"ai.tos.mode.debug\"), object: \"$1\", userInfo: nil, deliverImmediately: true)" 2>/dev/null
}
if [[ "$cmd" == "state" ]]; then
  post dump
  sleep 0.4
  cat "$STATE"
else
  post "$cmd"
fi
