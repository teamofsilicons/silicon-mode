    "spring": {
      "fast": {
        "visualDuration": 0.05,
        "bounce": 0,
        "exitDuration": 0.06,
        "use": "hover, press, toggles, thumbs, small indicators"
      },
      "moderate": {
        "visualDuration": 0.09,
        "bounce": 0,
        "exitDuration": 0.12,
        "use": "menus, popovers, tabs, drawers, height changes"
      },
      "slow": {
        "visualDuration": 0.15,
        "bounce": 0.12,
        "exitDuration": 0.16,
        "use": "dialogs, sheets, shape morphs, large shared-layout moves"
      },
      "expressive": {
        "visualDuration": 0.42,
        "bounce": 0.16,
        "use": "charts, counters, values settling"
      },
      "swiftUI": "Animation.spring(duration: visualDuration, bounce: bounce); exits: .easeIn(duration: exitDuration) with timingCurve(0.7,0,0.84,0)"
    },
    "staggerMs": {
      "char": 16,
      "word": 40,
      "line": 80,
      "item": 35,
      "maxTotal": 400
